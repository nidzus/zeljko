#!/bin/sh
# Privacy check on what is about to be committed. Turned on by
# "python jyotisha.py hooks" (install does it). If it cannot run, the commit
# is refused rather than let through unchecked.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
else PY=python3
fi
exec "$PY" tools/check_clean.py --staged
