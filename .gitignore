# Personal data never lives in the app folder: it is in the data folder (see
# backend/paths.py). These patterns are a second line of defence, and
# tools/check_clean.py the third.
/data/
/exports/
/readings/
/Website/
*.db
*.db.bak*
*.pdf
.env
private-words.txt
CLAUDE.local.md
.jyotisha.json

