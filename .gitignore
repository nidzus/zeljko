/.mcp.json
/jyotisha-plugin/.mcp.json

# The environment. Rebuilt by "Install or repair"; never tracked.
.venv/
.venv-old/
__pycache__/
*.pyc

# Per-machine Claude Code settings.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
